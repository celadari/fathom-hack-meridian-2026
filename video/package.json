{
  "name": "fathom-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "record": "node recorder/record.mjs",
    "render": "node recorder/verify.mjs && remotion render Main out/fathom-demo.mp4 --codec h264",
    "typecheck": "tsc --noEmit",
    "verify": "node recorder/verify.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
