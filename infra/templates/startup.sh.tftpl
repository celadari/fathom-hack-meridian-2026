#!/usr/bin/env bash
# Fathom demo server VM. Runs at every boot (idempotent).
#  - Docker (Ubuntu archive) and cloudflared (Cloudflare apt repo), over IPv6: the VM has no external IPv4.
#  - fathom-secrets: reads the keys, demo token and tunnel token from Secret Manager into /run (tmpfs).
#  - fathom-demo: the demo-server image, Restart=always, host network, listening on 127.0.0.1 only.
#  - fathom-tunnel: cloudflared, exposing 127.0.0.1:8787 as https://api.<domain>.
set -euo pipefail

PROJECT="${project}"
REGISTRY_HOST="${registry_host}"
IMAGE="${image}"
KEYS_SECRET="${keys_secret}"
TOKEN_SECRET="${demo_token_secret}"
TUNNEL_SECRET="${tunnel_secret}"
ALLOWED_ORIGINS="${allowed_origins}"

# e2-micro has 1 GB of RAM: add 1 GB of swap.
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
swapon -a || true

export DEBIAN_FRONTEND=noninteractive
if ! command -v docker >/dev/null || ! command -v jq >/dev/null; then
  apt-get update -q
  apt-get install -yq docker.io jq curl ca-certificates
  systemctl enable --now docker
fi
if ! command -v cloudflared >/dev/null; then
  install -d -m 0755 /usr/share/keyrings
  curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg
  echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' > /etc/apt/sources.list.d/cloudflared.list
  apt-get update -q
  apt-get install -yq cloudflared
fi

install -d -m 0755 /opt/fathom

# Reads secrets with the VM service account's token (metadata server). Output only to /run (tmpfs).
cat > /opt/fathom/fetch-secrets.sh <<EOF
#!/usr/bin/env bash
set -euo pipefail
token() { curl -fsS -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token | jq -r .access_token; }
secret() { curl -fsS -H "Authorization: Bearer \$(token)" "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/\$1/versions/latest:access" | jq -r .payload.data | base64 -d; }
install -d -m 0700 /run/fathom
umask 077
{ secret "$KEYS_SECRET"; echo; echo "DEMO_TOKEN=\$(secret "$TOKEN_SECRET")"; echo "ALLOWED_ORIGINS=$ALLOWED_ORIGINS"; echo "HOST=127.0.0.1"; } > /run/fathom/demo.env
echo "TUNNEL_TOKEN=\$(secret "$TUNNEL_SECRET")" > /run/fathom/tunnel.env
token | docker login -u oauth2accesstoken --password-stdin "https://$REGISTRY_HOST" >/dev/null
EOF
chmod 0700 /opt/fathom/fetch-secrets.sh

cat > /etc/systemd/system/fathom-secrets.service <<EOF
[Unit]
Description=Fathom: read secrets from Secret Manager into /run/fathom
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/fathom/fetch-secrets.sh
Restart=on-failure
RestartSec=10
EOF

cat > /etc/systemd/system/fathom-demo.service <<EOF
[Unit]
Description=Fathom demo server
After=fathom-secrets.service
Requires=fathom-secrets.service docker.service
[Service]
ExecStartPre=-/usr/bin/docker rm -f fathom-demo
ExecStartPre=/usr/bin/docker pull $IMAGE
ExecStart=/usr/bin/docker run --rm --name fathom-demo --network host --read-only --tmpfs /tmp --security-opt no-new-privileges:true --env-file /run/fathom/demo.env -v fathom-state:/data $IMAGE
ExecStop=/usr/bin/docker stop fathom-demo
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/fathom-tunnel.service <<EOF
[Unit]
Description=Fathom: Cloudflare tunnel to the demo server
After=fathom-secrets.service
Requires=fathom-secrets.service
[Service]
EnvironmentFile=/run/fathom/tunnel.env
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run
Restart=always
RestartSec=10
DynamicUser=yes
[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl restart fathom-secrets.service
systemctl enable fathom-demo.service fathom-tunnel.service
systemctl restart fathom-demo.service fathom-tunnel.service
