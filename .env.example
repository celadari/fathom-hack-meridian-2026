# Copy to .env.local (gitignored) to run your own demo server with keys from environment variables
# instead of the Stellar CLI keystore (FATHOM_KEYS_FROM_ENV_ONLY=1). Testnet demo keys only.
# Print yours with:  (cd scripts && npx tsx export-demo-secrets.ts)
FATHOM_KEY_ADMIN=
FATHOM_KEY_ISSUER=
FATHOM_KEY_ATTACKER=
FATHOM_KEY_SETTLER=
# Bots: FATHOM_KEY_CBOT_<NAME> (confidential stack), FATHOM_KEY_BOT_<NAME> (fixed-size stack),
# for ALICE BOB CAROL DAN EVE FRANK GRACE HEIDI.
# The auction's confidential spending key; scripts/deploy.ts creates it on first deploy.
FATHOM_CONF_AUCTION_SK=
# Optional: require a token for demo actions (16+ characters). Required when listening publicly.
DEMO_TOKEN=
